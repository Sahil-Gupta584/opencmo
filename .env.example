# Root environment file shared by all apps (web, api).
# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:pass@host:5432/postgres?schema=public

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Web app origin (trusted by backend/auth)
BETTER_AUTH_URL=http://localhost:3000

# oRPC API server (apps/api)
PORT=5001
# Base URL the web client uses to reach the API (browser + SSR)
VITE_API_URL=http://localhost:5001
# Comma-separated origins allowed to call the API with credentials (browser origin of the web app)
CORS_ORIGIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (magic link email)
RESEND_API_KEY=

# Firecrawl (product scraper)
FIRECRAWL_API_KEY=

# X / Twitter (inbound search)
TWITTER_BEARER_TOKEN=

# Dodo Payments - test_mode or live_mode
DODO_MODE=test_mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_INDIE_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=

# Sentry (web)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=