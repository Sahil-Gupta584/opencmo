generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image              String?
  subscriptionId     String?
  subscriptionStatus String?   @default("inactive")
  plan               String?   @default("FREE")
  notifyNewLeads     Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  accounts           Account[]
  projects           Project[]
  apiConfig          UserApiConfig?
  featureInterests   FeatureInterest[]
  alertPref          AlertPref?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Project {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  url            String?
  description    String              @db.Text
  targetAudience String?             @db.Text
  keywords       String[]
  isFetching     Boolean             @default(false)
  lastFetchedAt  DateTime?           // When the last inbound fetch completed
  isGeneratingContent Boolean        @default(false) // True while a daily content batch is being generated
  lastContentGeneratedAt DateTime?   // When the last daily content batch completed
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  subreddits     ProjectSubreddit[]
  threads        RedditThread[]
  cursors        InboundCursor[]
  drafts         ContentDraft[]
  dailyTasks     DailyTask[]

  @@map("project")
}

model UserApiConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultProvider String   @default("openai")
  openaiKey       String?
  anthropicKey    String?
  geminiKey       String?
  openrouterKey   String?
  twitterBearerToken String?
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_api_config")
}

model ProjectSubreddit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  relevance   Int      @default(0)
  description String?  @db.Text
  rulesJson   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([projectId, name])
  @@index([name])
  @@map("project_subreddit")
}



model RedditThread {
  id             String       @id @default(cuid())
  redditId       String       // Unique post ID (Reddit ID, Tweet ID, LinkedIn ID)
  channel        String       @default("reddit") // "reddit" | "twitter" | "linkedin"
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  subreddit      String
  title          String
  body           String?      @db.Text
  author         String
  url            String
  score          Int          @default(0)
  commentCount   Int          @default(0)
  redditCreatedAt DateTime    // Created date - used as cursor

  priority      String?      @default("medium") // "high" | "medium" | "low", AI ranked
  intentReason  String?      @db.Text

  isDone         Boolean      @default(false)
  generatedReply String?      @db.Text

  fetchedAt      DateTime     @default(now())

  @@unique([projectId, redditId])
  @@index([projectId, channel, isDone, redditCreatedAt])
  @@map("reddit_thread")
}

model InboundCursor {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subreddit   String
  keyword     String
  lastSeenAt  DateTime // MAX(redditCreatedAt) of last fetched batch
  updatedAt   DateTime @updatedAt

  @@unique([projectId, subreddit, keyword])
  @@map("inbound_cursor")
}

model ContentDraft {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subreddit  String
  type       String   @default("POST")
  title      String?
  content    String   @db.Text
  riskScore  Int      @default(0)
  riskReport String?  @db.Text
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())

  @@map("content_draft")
}

model DailyTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String   @db.Text
  actionUrl   String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("daily_task")
}

model FeatureInterest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature    String   // e.g. "mentions"
  interested Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, feature])
  @@map("feature_interest")
}

model AlertPref {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled   Boolean  @default(true)
  notifyInbounds Boolean  @default(true)
  notifyOutbound Boolean  @default(true)
  channels       String[] // requested channels: whatsapp, slack, discord, or custom
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("alert_pref")
}
